{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://nah.rtorr.com/schemas/launch.v2.json",
  "title": "NAH launch contract",
  "description": "Resolved, immutable process input produced by NAH",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "app", "nak", "execution", "environment", "permissions", "trust"],
  "properties": {
    "schema": {"const": "nah.launch.contract.v2"},
    "app": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "root", "entrypoint", "package_hash"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "root": {"type": "string", "minLength": 1},
        "entrypoint": {"type": "string", "minLength": 1},
        "package_hash": {"type": "string", "pattern": "^(|sha256:[a-f0-9]{64})$"}
      }
    },
    "nak": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "root", "resource_root", "record_ref", "package_hash"],
      "properties": {
        "id": {"type": "string"},
        "version": {"type": "string"},
        "root": {"type": "string"},
        "resource_root": {"type": "string"},
        "record_ref": {"type": "string"},
        "package_hash": {"type": "string", "pattern": "^(|sha256:[a-f0-9]{64})$"}
      }
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["binary", "arguments", "cwd", "library_path_env_key", "library_paths"],
      "properties": {
        "binary": {"type": "string", "minLength": 1},
        "arguments": {"type": "array", "items": {"type": "string"}},
        "cwd": {"type": "string", "minLength": 1},
        "library_path_env_key": {"type": "string"},
        "library_paths": {"type": "array", "items": {"type": "string"}}
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": {"type": "string"}
    },
    "permissions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["filesystem", "network"],
      "properties": {
        "filesystem": {"type": "array", "items": {"type": "string"}},
        "network": {"type": "array", "items": {"type": "string"}}
      }
    },
    "trust": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "source", "evaluated_at", "expires_at"],
      "properties": {
        "state": {"enum": ["verified", "unverified", "failed", "unknown"]},
        "source": {"type": "string"},
        "evaluated_at": {"type": "string"},
        "expires_at": {"type": "string"}
      }
    }
  }
}
