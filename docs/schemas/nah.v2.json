{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://nah.rtorr.com/schemas/nah.v2.json",
  "title": "NAH host environment",
  "description": "Mutable host-owned configuration stored at <root>/host/host.json",
  "type": "object",
  "additionalProperties": false,
  "definitions": {
    "envValue": {
      "oneOf": [
        {
          "type": "string"
        },
        {
          "type": "object",
          "required": ["op"],
          "additionalProperties": false,
          "properties": {
            "op": {
              "enum": ["set", "prepend", "append", "unset"]
            },
            "value": {
              "type": "string"
            },
            "separator": {
              "type": "string",
              "default": ":"
            }
          },
          "allOf": [{
            "if": {"properties": {"op": {"enum": ["set", "prepend", "append"]}}},
            "then": {"required": ["value"]}
          }]
        }
      ]
    }
  },
  "properties": {
    "$schema": {
      "const": "https://nah.rtorr.com/schemas/nah.v2.json"
    },
    "environment": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/definitions/envValue"
      },
      "default": {}
    },
    "paths": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "library_prepend": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "default": []
        },
        "library_append": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "default": []
        }
      }
    }
  }
}
